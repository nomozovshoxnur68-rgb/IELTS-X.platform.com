# Copy to .env (or set these in your host / Vercel dashboard). Never commit real values:
# this file is public. Real keys belong only in .env (ignored by git) and in the Vercel dashboard.

# Accounts with these emails become admins automatically (comma separated).
ADMIN_EMAILS=you@example.com

# Long random string. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Locally it is optional (one is generated into data/.session-secret). REQUIRED on Vercel.
SESSION_SECRET=

# Optional: "Continue with Google" button (OAuth client ID from Google Cloud Console).
GOOGLE_CLIENT_ID=

# Optional: extra pages that need Premium, comma separated (Mock tests.html is always protected).
PREMIUM_PATHS=

# Production storage (required on Vercel, see VERCEL_SETUP.md).
# The service_role key can read and change the whole database: keep it secret, never put it in a file in git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site (used in e-mail links and sitemap.xml), e.g. https://ielts-x-platform-com.vercel.app
PUBLIC_URL=https://your-site.vercel.app

# E-mail for "verify your email" and "reset password" (https://resend.com, free tier is enough).
# Without these the links are printed in the server console instead, and students are told to write to PAYMENT_CONTACT.
RESEND_API_KEY=
MAIL_FROM=IELTS X <no-reply@your-domain.com>

# Payments: orders are confirmed by an admin in the panel. A payment provider (or a bot) can confirm them
# automatically by POSTing to /api/payments/webhook with header X-Signature = hex HMAC-SHA256(body, secret).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CONTACT=https://t.me/your_support
PAYMENT_INSTRUCTIONS=
# Prices live in plans.json (or set PLANS_JSON with the same content).

# AI: the Test Generator (admin panel) and the AI check of Writing and Speaking. Server-side only: the key never reaches a browser.
# Get a key at https://platform.openai.com/api-keys and add credit at https://platform.openai.com/settings/organization/billing
# (a ChatGPT subscription does not include the API). Without a key the panel shows how to set it up; nothing else changes.
OPENAI_API_KEY=
# openai (default), gemini (then GEMINI_API_KEY from https://aistudio.google.com/apikey) or mock (no key: placeholder questions, to try the panel)
AI_PROVIDER=openai
GEMINI_API_KEY=
# The model that writes the answers. Empty = gpt-6-luna, then gpt-5.6-luna if the key may not use it. A model set here is used alone.
AI_MODEL=
# OpenAI: the model that hears a spoken answer (pronunciation and fluency notes; default gpt-audio-1.5) and the one that writes it down (default gpt-transcribe)
AI_AUDIO_MODEL=
AI_TRANSCRIBE_MODEL=
# How much the model reasons before answering: low (default, fast enough for one Vercel call), medium or high
AI_THINKING=
# Optional: generations per admin per hour (default 30), largest recording in MB (default 60, OpenAI takes 25 at most), time per AI call in ms
AI_HOURLY_LIMIT=
AI_MAX_AUDIO_MB=
AI_TIMEOUT_MS=

# AI check of Writing and Speaking for students: the same OPENAI_API_KEY as above. Checks per student per month
# (empty = 3, 30, 60 and 200; a failed check is not counted; admins have no limit).
AI_CHECKS_FREE=
AI_CHECKS_STANDARD=
AI_CHECKS_MAX=
AI_CHECKS_ULTRA=

PORT=3000
# several copies of the server on this port (needs Supabase): a number, or "auto" = one per CPU core. Not needed on Vercel.
# WEB_CONCURRENCY=auto