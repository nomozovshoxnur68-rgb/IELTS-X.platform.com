# Copy to .env (or set these in your host / Vercel dashboard). Never commit real values:
# this file is public. Real keys belong only in .env (ignored by git) and in the Vercel dashboard.

# Accounts with these emails become admins automatically (comma separated).
ADMIN_EMAILS=you@example.com

# Long random string. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Locally it is optional (one is generated into data/.session-secret). REQUIRED on Vercel.
SESSION_SECRET=

# Optional: "Continue with Google" button (OAuth client ID from Google Cloud Console).
GOOGLE_CLIENT_ID=

# Optional: extra pages that need Premium, comma separated (Mock tests.html is always protected).
PREMIUM_PATHS=

# Production storage (required on Vercel, see VERCEL_SETUP.md).
# The service_role key can read and change the whole database: keep it secret, never put it in a file in git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site (used in e-mail links and sitemap.xml), e.g. https://ielts-x-platform-com.vercel.app
PUBLIC_URL=https://your-site.vercel.app

# E-mail for "verify your email" and "reset password" (https://resend.com, free tier is enough).
# Without these the links are printed in the server console instead, and students are told to write to PAYMENT_CONTACT.
RESEND_API_KEY=
MAIL_FROM=IELTS X <no-reply@your-domain.com>

# Payments: orders are confirmed by an admin in the panel. A payment provider (or a bot) can confirm them
# automatically by POSTing to /api/payments/webhook with header X-Signature = hex HMAC-SHA256(body, secret).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CONTACT=https://t.me/your_support
PAYMENT_INSTRUCTIONS=
# Prices live in plans.json (or set PLANS_JSON with the same content).

# AI Test Generator (admin panel -> AI Test Generator). Server-side only: the key never reaches a browser.
# Get a key at https://aistudio.google.com/apikey. Without it the panel shows how to set it up; nothing else changes.
GEMINI_API_KEY=
# gemini (default) or mock (no key: placeholder questions, to try the panel)
AI_PROVIDER=gemini
# A Gemini model; default gemini-flash-latest (Google's alias for the current Flash model), e.g. gemini-2.5-flash
AI_MODEL=
# Optional: generations per admin per hour (default 30), largest recording in MB (default 60), time per AI call in ms
AI_HOURLY_LIMIT=
AI_MAX_AUDIO_MB=
AI_TIMEOUT_MS=

PORT=3000
